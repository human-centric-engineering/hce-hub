# Non-secret local development settings for THIS app.
#
# Unlike .env.local (ignored, holds secrets), this file is committed: it is how
# an app pins the port it binds so every clone agrees and `npm run dev` needs no
# arguments. Read by scripts/dev-server.mjs — see
# .context/environment/services-env.md#port
#
# Secrets belong in .env.local. Never add one here.

# HCE Hub's own dev port. Sunrise ships 3010 and a fork inherits it on the first
# merge — two Sunrise-derived apps that both keep the default collide the moment
# they run together, which is exactly the situation here (the Hub is developed
# alongside Sunrise itself). Claimed 3012 so both can run at once.
#
# If you change this, restart the dev server: NEXT_PUBLIC_APP_URL /
# BETTER_AUTH_URL and the loopback self-call (getBaseUrl → 127.0.0.1:$PORT in
# development) all resolve against it. Behind a reverse proxy, this is the port
# the proxy forwards to.
PORT=3012
